# ─────────────────────────────────────────────────────────────────
#  Firebase config  ·  copy this file to ".env" and fill in your keys
# ─────────────────────────────────────────────────────────────────
#  Steps:
#   1. https://console.firebase.google.com  →  "Add project"
#   2. Project settings (gear ⚙️) → "Your apps" → Web app (</>) → register
#   3. Copy the config values into the fields below
#   4. Build → Authentication → Sign-in method → enable "Google" + "Email/Password"
#   5. Build → Firestore Database → Create database (start in production mode)
#   6. Firestore → Rules → paste the rules from README-firebase.md
#
#  NOTE: Vite sirf VITE_ prefix waale vars ko expose karta hai.
#        .env commit mat karna (already .gitignore me hai).

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
